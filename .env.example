# Alle Werte sind optional, solange die Defaults passen (siehe app/config.py).
# Ausnahme: ohne ADMIN_PASSWORD_HASH bleibt das Backoffice geschlossen.

# --- Betrieb ---
# Wird von "python -m app" gelesen. Liegt der Reverse Proxy auf demselben Host,
# bleibt es bei 127.0.0.1; sitzt er woanders, hier die eigene IP eintragen und
# den Port per Firewall auf den Proxy beschraenken.
BIND=127.0.0.1:8080

# Von welchen Adressen X-Forwarded-For und X-Forwarded-Proto geglaubt werden.
# Muss die IP des Reverse Proxys sein - sonst steht bei jedem Antrag dessen IP
# als Absender und das Login-Rate-Limit trifft alle gemeinsam.
FORWARDED_ALLOW_IPS=127.0.0.1

DB_PATH=data/antraege.db

# Pfad des oeffentlichen Formulars. "/" = Startseite.
# Fuer "security by obscurity" z. B. /antrag/abfahrt30
FORM_PATH=/

# --- Fachlich ---
VERANSTALTUNG=Die absolute Abfahrt
KATEGORIEN=camping:Camping,expo:Expo,local:Local/Durchfahrt,parken:Parken,vip:VIP

# Ein Satz je Kategorie, der im Formular unter der Auswahl steht. Eine eigene
# Variable je Kategorie, weil in KATEGORIEN Komma und Doppelpunkt trennen und
# beides in einem Satz vorkommt. Der Name ist KATEGORIE_TEXT_<SCHLUESSEL> in
# Grossbuchstaben. Fuer die fuenf Vorgabe-Kategorien sind Texte eingebaut, hier
# stehen sie nur zum Ueberschreiben.
# KATEGORIE_TEXT_CAMPING=Du bist Helfer und moechtest auf dem Campingplatz uebernachten.
# KATEGORIE_TEXT_EXPO=Du bist Aussteller und hast einen EXPO-Platz gebucht.
# KATEGORIE_TEXT_LOCAL=Du musst als Anlieger die Strassensperre passieren.
# KATEGORIE_TEXT_PARKEN=Du musst auf dem Parkplatz der Veranstaltung parken.
# KATEGORIE_TEXT_VIP=Du musst auf dem Veranstaltungsgelaende parken.

# Amtliches Kfz-Kennzeichen im Formular erfassen (offene Frage 3 im Plan)
KENNZEICHEN_ERFASSEN=1

# Obergrenze je Kategorie (offene Frage 1 im Plan). Leer = keine Grenze und
# keine Warnung. Gezaehlt werden genehmigte und ausgegebene Antraege.
# Beispiel: KONTINGENTE=camping:120,vip:40
KONTINGENTE=

# --- Ansprechpartner (erscheint im Formular und im Datenschutzhinweis) ---
KONTAKT_NAME=Orga Absolute Abfahrt
KONTAKT_MAIL=
KONTAKT_TELEFON=

# --- Datenschutz ---
# Remote-IP speichern (nur fuer Missbrauchsfaelle). 0 = gar nicht erst erheben.
IP_SPEICHERN=1
# Aufbewahrungshinweis im Formular
AUFBEWAHRUNG_HINWEIS=Die Daten werden spaetestens vier Wochen nach der Veranstaltung geloescht.

# --- Backoffice / Anmeldung (Schritt 3) ---
# Hash erzeugen mit:  python -m app.passwort
ADMIN_PASSWORD_HASH=

# Signiert die Session-Cookies. Ohne Wert wird beim Start einer erzeugt und
# alle Anmeldungen enden mit dem naechsten Neustart. Im Betrieb setzen:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

SESSION_STUNDEN=12

# auto = Secure-Flag setzen, wenn der Browser ueber HTTPS kam (Proxy-Header).
# Hinter dem Reverse Proxy passt "auto"; 1 erzwingt es, 0 schaltet es ab.
COOKIE_SECURE=auto

# Rate Limit fuer die Anmeldung, pro IP
LOGIN_VERSUCHE=5
LOGIN_FENSTER_SEKUNDEN=60

# Bearbeiter-Kuerzel bei der Anmeldung abfragen (offene Frage 5 im Plan)
KUERZEL_ABFRAGEN=1

# --- CSV-Export (Schritt 8) ---
# Semikolon oeffnet Excel unter deutschem Windows ohne Import-Dialog.
# Fuer maschinelle Weiterverarbeitung auf , stellen.
CSV_TRENNER=;

# --- Karten drucken (Schritt 11) ---
# Ziel des QR-Codes auf der Karte. Gescannt fuehrt er in die Detailansicht des
# Antrags, die eine Anmeldung verlangt. Leer = der Code traegt nur die Nummer.
KARTEN_URL_BASIS=

# Jubilaeums-Logo. Dateiname DIREKT in app/static, kein Pfad. Fehlt die Datei,
# steht auf der Karte nur der Veranstaltungsname.
LOGO_DATEI=

# --- Mailversand (Schritt 6) ---
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT=20

MAIL_FROM=
MAIL_REPLY_TO=

# Wie oft der Worker nachsieht und wie oft er eine Mail hoechstens versucht
MAIL_INTERVALL=30
MAIL_MAX_VERSUCHE=5

# Wo und wann die Karten uebergeben werden (offene Frage 4 im Plan).
# Solange das leer ist, nennt die Genehmigungsmail weder Ort noch Uhrzeit.
# Beispiel: ABHOLUNG=Die Karte bekommst du am Freitag ab 16 Uhr am Orgazelt.
ABHOLUNG=
