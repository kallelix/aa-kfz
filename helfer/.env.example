# Helfer-Dashboard – Vorlage. Kopieren nach helfer/.env und ausfüllen.
# Echte Adressen, Passwörter und Schlüssel gehören NICHT ins Repository.

# --- Betrieb ---------------------------------------------------------------

# Worauf gelauscht wird. Hinter einem Reverse Proxy auf demselben Host reicht
# 127.0.0.1. Liegt der Proxy woanders, muss hier die eigene IP stehen – und
# der Port per Firewall auf den Proxy beschränkt werden.
BIND=127.0.0.1:8082

# Von welcher Adresse X-Forwarded-For geglaubt wird. MUSS eine IP sein, kein
# Hostname – uvicorn löst hier nichts auf. Steht hier etwas Falsches, landet
# in jedem Protokoll die IP des Proxys statt die des Besuchers.
FORWARDED_ALLOW_IPS=127.0.0.1

DB_PATH=/var/lib/abfahrt-helfer/helfer.db

# Öffentliche Adresse, für den Monitor-Link.
BASIS_URL=https://helfer.example.de

# --- Veranstaltung ---------------------------------------------------------

VERANSTALTUNG=Die absolute Abfahrt
ORT=Ilmenau

# Die Renntage. Der Zeitplan-Abruf bildet damit Wochentage auf Daten ab.
# Auf- und Abbauschichten dürfen davor und danach liegen.
TAGE=2026-08-28,2026-08-29,2026-08-30

# Die Uhr, nach der das Dashboard geht – unabhängig davon, wie der Server
# gestellt ist.
ZEITZONE=Europe/Berlin

# Nur für Durchsichten: stellt die Uhr auf einen festen Zeitpunkt, damit sich
# die Monitoransicht während der Veranstaltung anschauen lässt. Im Betrieb
# LEER LASSEN.
JETZT_FEST=

# --- Monitor ---------------------------------------------------------------

# Wie oft die Monitoransicht neu lädt (Sekunden).
MONITOR_INTERVALL=60

# Wie weit sie nach vorn schaut (Minuten).
MONITOR_VORSCHAU=120

# Ab wie vielen fehlenden Helfern eine Schicht hervorgehoben wird. 0 = nie.
MONITOR_WARNUNG=1

# --- Ansprechpartner -------------------------------------------------------

KONTAKT_NAME=Orga-Team Absolute Abfahrt
KONTAKT_MAIL=vorstand@example.de
KONTAKT_TELEFON=

# --- Backoffice ------------------------------------------------------------

# Hash erzeugen mit: python -m app.passwort
ADMIN_PASSWORD_HASH=

# Zufällig, mindestens 32 Zeichen. Ohne diesen Wert endet bei jedem Neustart
# jede Anmeldung. Erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

SESSION_STUNDEN=12

# auto = an HTTPS koppeln (der Proxy meldet es über X-Forwarded-Proto).
COOKIE_SECURE=auto

LOGIN_VERSUCHE=5
LOGIN_FENSTER_SEKUNDEN=60

# Kürzel bei der Anmeldung abfragen – wird bei jeder Einteilung vermerkt.
KUERZEL_ABFRAGEN=1

# --- Sonstiges -------------------------------------------------------------

# Trennzeichen im CSV-Export. Excel im deutschen Gebietsschema will ';'.
# Für den IMPORT ist das egal, der erkennt ',' und ';' selbst.
CSV_TRENNER=;
