# Vorlage fuer /etc/abfahrt/helfer.env
#
#   install -o root -g root -m 600 deploy/helfer.env.example /etc/abfahrt/helfer.env
#
# Achtung: systemd liest diese Datei NICHT wie eine Shell. Keine Anfuehrungs-
# zeichen um Werte mit Leerzeichen, keine Zeilenfortsetzungen.
#
# Ohne ADMIN_PASSWORD_HASH bleibt das Backoffice geschlossen.
# Mailversand gibt es in dieser App nicht - keine SMTP-Werte noetig.

# --- Betrieb ---
# IP DIESES Containers, nicht 0.0.0.0. Der Port gehoert per Firewall auf den
# nginx beschraenkt.
BIND=10.0.0.44:8082

# IP des nginx. Nur von dort werden X-Forwarded-For und X-Forwarded-Proto
# geglaubt. MUSS eine IP sein, kein Hostname - uvicorn loest hier nichts auf.
FORWARDED_ALLOW_IPS=10.0.0.10

DB_PATH=/var/lib/helfer/helfer.db

# Oeffentliche Adresse. Wird gebraucht, damit im Backoffice der vollstaendige
# Monitor-Link steht, den man auf den Bildschirmrechner uebertraegt.
BASIS_URL=https://helfer.example.de

# --- Veranstaltung ---
VERANSTALTUNG=Die absolute Abfahrt
ORT=Ilmenau

# Die drei Renntage. Der Zeitplan-Abruf bildet damit die Wochentage aus den
# Tabellen der Rennserien ("Freitag") auf Daten ab. Auf- und Abbauschichten
# duerfen davor und danach liegen, die stehen in den CSV-Dateien mit Datum.
TAGE=2026-08-28,2026-08-29,2026-08-30

# Die Uhr, nach der Dashboard und Monitor gehen - unabhaengig davon, wie der
# Server gestellt ist.
ZEITZONE=Europe/Berlin

# NUR fuer Durchsichten: stellt die Uhr auf einen festen Zeitpunkt, damit sich
# die Monitoransicht ausserhalb der Veranstaltung anschauen laesst.
#
# IM BETRIEB MUSS DAS LEER BLEIBEN. Steht hier etwas, zeigt der Monitor eine
# erfundene Uhrzeit - und niemand merkt es, weil ja eine Uhr zu sehen ist.
# Der Dienst schreibt beim Start eine Warnung ins Journal, wenn der Wert
# gesetzt ist.
JETZT_FEST=

# --- Monitor ---
# Wie oft sich die Monitoransicht auffrischt (Sekunden).
MONITOR_INTERVALL=60

# Wie weit "Als Naechstes" vorausschaut (Minuten).
MONITOR_VORSCHAU=120

# Ab wie vielen fehlenden Helfern eine Schicht hervorgehoben wird. 0 = nie.
MONITOR_WARNUNG=1

# Wie lange eine angetippte Schicht offen bleibt, bevor der Monitor von selbst
# zurueckkehrt (Sekunden). 0 schaltet den Selbstschliesser ab.
MONITOR_OVERLAY_SEKUNDEN=90

# Wie lange der Tagesblick offen bleibt, bevor der Monitor auf "Jetzt"
# zurueckspringt (Sekunden). 0 schaltet den Ruecksprung ab.
#
# Beide Werte auf 0 zu setzen heisst: der Bildschirm bleibt dort stehen, wo
# der letzte Neugierige ihn hinterlassen hat.
MONITOR_TAGESBLICK_SEKUNDEN=120

# --- Zeitplan der Rennserien ---
# Der Dienst holt den Zeitplan taeglich von den Websites der Serien. Dafuer
# braucht der Container AUSGEHENDE HTTPS-Verbindungen und ca-certificates.
# Ohne beides schlaegt der Abruf fehl - der letzte erfolgreiche Stand bleibt
# dann stehen, und das Backoffice zeigt den Fehler.
ZEITPLAN_SERIEN=dhc,kids

# Zu welcher vollen Stunde (0-23) automatisch abgerufen wird. -1 schaltet den
# automatischen Abruf ab; von Hand geht er im Backoffice immer.
ZEITPLAN_STUNDE=4

# Adresse und Abschnitt je Serie lassen sich ueberschreiben, falls eine Seite
# umzieht oder ihre Ueberschrift aendert. Der Abschnitt ist die Ueberschrift
# ueber der richtigen Tabelle - auf der DHC-Seite stehen zwei Zeitplaene
# untereinander, "allgemein" und "Willingen".
# ZEITPLAN_DHC_URL=https://www.ixsdownhillcup.com/zeitplan/dhc-zeitplan
# ZEITPLAN_DHC_ABSCHNITT=allgemein
# ZEITPLAN_KIDS_URL=https://www.kidscup.bike/zeitplan
# ZEITPLAN_KIDS_ABSCHNITT=allgemein

# --- Ansprechpartner ---
KONTAKT_NAME=Orga-Team Absolute Abfahrt
KONTAKT_MAIL=vorstand@example.de
KONTAKT_TELEFON=

# --- Backoffice ---
# Hash erzeugen mit: /opt/abfahrt/.venv/bin/python -m app.passwort
ADMIN_PASSWORD_HASH=

# Zufaellig, mindestens 32 Zeichen. Ohne diesen Wert endet bei jedem Neustart
# jede Anmeldung - und der Monitor-Link bleibt trotzdem gueltig, der haengt
# nicht am Schluessel, sondern in der Datenbank.
# Erzeugen mit:
#   /opt/abfahrt/.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

SESSION_STUNDEN=12
COOKIE_SECURE=auto
LOGIN_VERSUCHE=5
LOGIN_FENSTER_SEKUNDEN=60

# Kuerzel bei der Anmeldung abfragen - wird bei jeder Einteilung vermerkt.
KUERZEL_ABFRAGEN=1

# --- Sonstiges ---
# Trennzeichen fuer spaetere Exporte. Fuer den IMPORT der beiden CSV-Dateien
# ist das egal, der erkennt Komma und Semikolon selbst.
CSV_TRENNER=;

# --- Abruf der Helferliste --------------------------------------------------

# Statt beide CSV-Dateien von Hand herunterzuladen und hochzuladen, holt der
# Import sie selbst. Leer lassen heisst: es bleibt beim Hochladen.
#
# ACHTUNG: Alle drei Adressen enthalten persoenliche Zugangstoken. Sie
# gehoeren NUR hierher, nie ins Repository, nie in eine Fehlermeldung, nie in
# einen Chat. Der Login-Link ist der Sache nach ein Passwort - wer ihn hat,
# sieht die ganze Helferliste samt Adressen und Telefonnummern.
#
# Der Login-Link ist noetig, weil der Token in den CSV-Adressen allein nicht
# genuegt: ohne Sitzung antwortet der Dienst mit der Anmeldeseite statt mit
# der Datei. Der Link ist mehrfach verwendbar; anzufordern ist er beim Dienst
# unter "Ich benoetige einen Login-Link".
#
# IMPORT_LOGIN_URL=https://www.helferliste.online/home.php?i=DEIN-LOGIN-TOKEN
# IMPORT_URL_VERGEBEN=https://www.helferliste.online/helfer.php?vid=DEINE-ID&t=DEIN-TOKEN&download_csv=1
# IMPORT_URL_OFFEN=https://www.helferliste.online/helfer.php?vid=DEINE-ID&t=DEIN-TOKEN&download_csv=2
