# Vorlage fuer /etc/abfahrt/presse.env
#
#   install -o root -g root -m 600 deploy/presse.env.example /etc/abfahrt/presse.env
#
# Achtung: systemd liest diese Datei NICHT wie eine Shell. Keine Anfuehrungs-
# zeichen um Werte mit Leerzeichen, keine Zeilenfortsetzungen.
#
# Ohne ADMIN_PASSWORD_HASH bleibt das Backoffice geschlossen.

# --- Betrieb ---
# IP DIESES Containers, nicht 0.0.0.0. Der Port gehoert per Firewall auf den
# nginx beschraenkt. Eigener Port, damit die beiden Apps sich nicht ins Gehege
# kommen, falls sie doch mal im selben Container landen.
BIND=10.0.0.43:8081

# IP des nginx. Nur von dort werden X-Forwarded-For und X-Forwarded-Proto
# geglaubt. Falsch gesetzt heisst: alle Anmeldungen haben dieselbe Absender-IP
# und ein Fehlversuch beim Login sperrt alle aus.
FORWARDED_ALLOW_IPS=10.0.0.10
DB_PATH=/var/lib/presse/presse.db

# Pfad des oeffentlichen Formulars. "/" = Startseite.
FORM_PATH=/

# Oeffentliche Adresse, z. B. https://presse.example.de
# Leer = aus der Anfrage ableiten.
BASIS_URL=

# --- Fachlich ---
VERANSTALTUNG=Die absolute Abfahrt
ORT=Ilmenau

# Akkreditierungsgebuehr bei kommerzieller Verwertung
GEBUEHR_BETRAG=20
GEBUEHR_WAEHRUNG=EUR

# Umfang der Bilderspende als Alternative zur Gebuehr
BILDER_ANZAHL=10

# Wohin die gespendeten Bilder sollen - steht in der Erinnerungsmail.
# Solange leer, bleibt der Text dort allgemein.
BILDER_ABGABE=

ABHOLORT=Orga-Buero

# Die Badges sind vorproduziert, also endlich. 0 = keine Obergrenze.
# Ist die Zahl erreicht, warnt Formular und Backoffice - abgewiesen wird
# aber niemand, siehe docs/plan-presse-akkreditierung.md.
BADGES_GESAMT=0

# --- Ansprechpartner ---
KONTAKT_NAME=Orga-Team Absolute Abfahrt
KONTAKT_MAIL=
KONTAKT_TELEFON=

# --- Datenschutz ---
IP_SPEICHERN=1
# Der Datenschutzhinweis steht in app/templates/anmeldung.html, nicht hier:
# die Aufbewahrungsdauer ist eine Rechtsaussage und gehoert versioniert.

# --- Backoffice ---
# Hash erzeugen mit:  python -m app.passwort
ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=
SESSION_STUNDEN=12
COOKIE_SECURE=auto
LOGIN_VERSUCHE=5
LOGIN_FENSTER_SEKUNDEN=60
# Kuerzel wird beim Ausgeben des Badges vermerkt
KUERZEL_ABFRAGEN=1

# --- Mailversand ---
# Ohne SMTP_HOST oder MAIL_FROM wird nichts verschickt; die Mails sammeln
# sich in mail_out und gehen nicht verloren.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT=20
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_INTERVALL=30
MAIL_MAX_VERSUCHE=5

# --- Sonstiges ---
CSV_TRENNER=;
