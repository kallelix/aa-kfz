# Vorlage fuer /etc/abfahrt/kennzeichen.env
#
#   install -o root -g root -m 600 kennzeichen.env.example /etc/abfahrt/kennzeichen.env
#
# Achtung: systemd liest diese Datei NICHT wie eine Shell. Keine Anfuehrungs-
# zeichen um Werte mit Leerzeichen, keine Zeilenfortsetzungen, keine Variablen-
# ersetzung. MAIL_FROM darf also so stehen, wie es unten steht.

# --- Netz -------------------------------------------------------------------
# nginx liegt auf einem anderen Host, deshalb kann die App nicht auf 127.0.0.1
# lauschen. Hier die IP DIESES Containers eintragen, nicht 0.0.0.0 - dann ist
# der Port wenigstens nicht auf allen Schnittstellen offen.
BIND=10.0.0.42:8080

# IP des nginx. Nur von dieser Adresse werden X-Forwarded-For und
# X-Forwarded-Proto geglaubt. Falsch gesetzt heisst: alle Antraege haben
# dieselbe Absender-IP und ein Fehlversuch beim Login sperrt alle aus.
FORWARDED_ALLOW_IPS=10.0.0.10

# --- Datenbank --------------------------------------------------------------
DB_PATH=/var/lib/abfahrt/antraege.db

# --- Geheimnisse ------------------------------------------------------------
# python -m app.passwort
ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# --- Fachlich ---------------------------------------------------------------
VERANSTALTUNG=Die absolute Abfahrt
KATEGORIEN=camping:Camping,expo:Expo,local:Local/Durchfahrt,parken:Parken,vip:VIP
KENNZEICHEN_ERFASSEN=1
# Leer = keine Obergrenze und keine Warnung
KONTINGENTE=

KONTAKT_NAME=Orga Absolute Abfahrt
KONTAKT_MAIL=
KONTAKT_TELEFON=

# --- Sitzung ----------------------------------------------------------------
SESSION_STUNDEN=12
# auto genuegt: nginx meldet ueber X-Forwarded-Proto, dass der Browser HTTPS sieht
COOKIE_SECURE=auto
LOGIN_VERSUCHE=5
LOGIN_FENSTER_SEKUNDEN=60
KUERZEL_ABFRAGEN=1

# --- Mail -------------------------------------------------------------------
# Nicht selbst aus dem Container versenden, sondern ueber das Postfach des
# Providers relayen. MAIL_FROM muss dieselbe Adresse tragen wie SMTP_USER,
# sonst weist der Relay ab. Konkrete Werte: siehe README, Zustellbarkeit.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_INTERVALL=30
MAIL_MAX_VERSUCHE=5
# Ort und Zeit der Kartenuebergabe. Leer = die Mail verspricht nichts.
ABHOLUNG=

# --- Karten drucken ---------------------------------------------------------
KARTEN_URL_BASIS=
# Dateiname direkt in /opt/abfahrt/app/static
LOGO_DATEI=

# --- Sonstiges --------------------------------------------------------------
CSV_TRENNER=;
IP_SPEICHERN=1
AUFBEWAHRUNG_HINWEIS=Die Daten werden spaetestens vier Wochen nach der Veranstaltung geloescht.
