[Unit]
Description=Die absolute Abfahrt – Kennzeichen, Presse und Helfer in einem Dienst
Documentation=file:/opt/abfahrt/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# Ohne Datenbank startet keiner der drei Bereiche. Kommt PostgreSQL nach
# einem Neustart des Containers erst spaet hoch, wartet der Dienst darauf.
Requires=postgresql.service

[Service]
Type=exec
User=abfahrt
Group=abfahrt

# Eine Unit statt drei. Vorher lag in jedem der drei Container ein eigener
# Klon mit eigener venv, eigenem Zertifikat und eigenem Sicherungslauf.
WorkingDirectory=/opt/abfahrt

# Hier stehen NUR die gemeinsamen Werte: Bind-Adresse, die vier Hostnamen,
# das Anmeldepasswort, der Schluessel fuer die Sitzung und die Datenbank. Was
# je Anwendung verschieden ist, steht in den drei Dateien, auf die
# KENNZEICHEN_ENV, PRESSE_ENV und HELFER_ENV zeigen.
EnvironmentFile=/etc/abfahrt/dienst.env

ExecStart=/opt/abfahrt/.venv/bin/python -m dienst

Restart=always
RestartSec=5

# --- Absicherung ---
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

# AF_INET/AF_INET6 braucht der Dienst nicht nur zum Lauschen, sondern auch
# fuer AUSGEHENDE Verbindungen: Mailversand, der taegliche Zeitplan-Abruf und
# der Helferabgleich. AF_UNIX muss mit, weil glibc unter Ubuntu ueber
# systemd-resolved aufloest und das ueber einen Unix-Socket laeuft - ohne die
# Familie scheitert schon die Namensaufloesung. Ueber AF_UNIX laeuft auch die
# Verbindung zu PostgreSQL.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

# Kein ReadWritePaths mehr: seit die Daten in PostgreSQL liegen, schreibt der
# Dienst keine einzige Datei. ProtectSystem=strict gilt damit ohne Ausnahme.

[Install]
WantedBy=multi-user.target
