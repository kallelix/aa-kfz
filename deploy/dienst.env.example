# Der zusammengesetzte Dienst – Vorlage.
#   install -o root -g root -m 600 deploy/dienst.env.example /etc/abfahrt/dienst.env
#
# Hier stehen NUR die gemeinsamen Werte. Alles, was je Anwendung verschieden
# ist – allen voran DB_PATH –, steht in den drei Dateien, auf die unten
# gezeigt wird. Die bleiben unverändert, so wie sie sind.

# --- Betrieb ----------------------------------------------------------------

BIND=127.0.0.1:8080

# MUSS eine IP sein, kein Hostname – uvicorn löst hier nichts auf. Steht hier
# etwas Falsches, landet in jedem Protokoll die IP des Proxys statt die des
# Besuchers.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Wer wohin gehört -------------------------------------------------------
#
# Der Dienst entscheidet am Hostnamen, welcher Bereich antwortet. Die drei
# öffentlichen Adressen bleiben, wie sie sind – sie stehen auf Plakaten, in
# Mails und in QR-Codes. Das Backoffice liegt neu unter einer vierten.
#
# Ist eine Zeile leer, ist der Bereich über seinen Namen nicht erreichbar.

HOST_KENNZEICHEN=kennzeichen.example.de
HOST_PRESSE=presse.example.de
HOST_HELFER=helfer.example.de
HOST_ADMIN=admin.example.de

# --- Anmeldung, für alle drei Bereiche dieselbe ------------------------------
#
# Ein Passwort und ein Schlüssel: wer sich unter HOST_ADMIN anmeldet, ist in
# allen drei Bereichen. Dass das aufgeht, hängt genau an diesen zwei Zeilen –
# stünden hier verschiedene Schlüssel, läge zwar ein Keks im Browser, aber
# seine Unterschrift passte im nächsten Bereich nicht.
#
# ACHTUNG: Diese beiden Werte gelten für alle drei Anwendungen und überschreiben,
# was in deren eigenen Dateien steht. Dort können sie deshalb weg.
#
#   /opt/abfahrt/.venv/bin/python -m kern.passwort
#   /opt/abfahrt/.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"

ADMIN_PASSWORD_HASH=
APP_SECRET_KEY=

# --- Wo die drei ihre eigenen Werte finden ----------------------------------
#
# Unverändert die Dateien von vorher. Dort steht je Anwendung DB_PATH,
# BASIS_URL, die Mailkonfiguration und alles Übrige.

KENNZEICHEN_ENV=/etc/abfahrt/kennzeichen.env
PRESSE_ENV=/etc/abfahrt/presse.env
HELFER_ENV=/etc/abfahrt/helfer.env
