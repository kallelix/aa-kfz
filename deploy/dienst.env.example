# Der zusammengesetzte Dienst – Vorlage.
#   install -o root -g root -m 600 deploy/dienst.env.example /etc/abfahrt/dienst.env
#
# Hier stehen NUR die gemeinsamen Werte. Alles, was je Anwendung verschieden
# ist – allen voran Adresse und Mailkonfiguration –, steht in den drei
# Dateien, auf die unten gezeigt wird.

# --- Betrieb ----------------------------------------------------------------

BIND=127.0.0.1:8080

# MUSS eine IP sein, kein Hostname – uvicorn löst hier nichts auf. Steht hier
# etwas Falsches, landet in jedem Protokoll die IP des Proxys statt die des
# Besuchers.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Datenbank --------------------------------------------------------------
#
# Eine PostgreSQL-Datenbank für alle drei Bereiche, jeder in seinem eigenen
# Schema (kennzeichen, presse, helfer). Die Tabellen legt der Dienst beim
# Start selbst an.
#
# Über den Unix-Socket und als der Systembenutzer, unter dem der Dienst
# läuft (peer): kein Passwort, das irgendwo stehen müsste. Rolle und
# Datenbank heißen wie der Benutzer, siehe deploy/README.md.

DATABASE_URL=postgresql://abfahrt@/abfahrt?host=/var/run/postgresql

# --- Wer wohin gehört -------------------------------------------------------
#
# Der Dienst entscheidet am Hostnamen, welcher Bereich antwortet. Die drei
# öffentlichen Adressen bleiben, wie sie sind – sie stehen auf Plakaten, in
# Mails und in QR-Codes. Das Backoffice liegt neu unter einer vierten.
#
# Ist eine Zeile leer, ist der Bereich über seinen Namen nicht erreichbar.

HOST_KENNZEICHEN=kennzeichen.example.de
HOST_PRESSE=presse.example.de
HOST_HELFER=helfer.example.de
HOST_ADMIN=admin.example.de

# --- Anmeldung, für alle drei Bereiche dieselbe ------------------------------
#
# Angemeldet wird mit persönlichen Konten (Mailadresse und Passwort), den
# ersten Admin legt python -m kern.konto admin an – siehe deploy/README.md.
#
# Der Schlüssel signiert die CSRF-Token und gilt für alle drei Bereiche:
#
#   /opt/abfahrt/.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(32))"

APP_SECRET_KEY=

# Nur für den Übergang: ein gemeinsames Passwort, mit dem man an die
# Kontenverwaltung kommt, solange es noch keinen Admin mit eigenem Konto gibt.
# Danach wird es abgewiesen, und die Zeile kann weg.
#
#   /opt/abfahrt/.venv/bin/python -m kern.passwort
#
# ADMIN_PASSWORD_HASH=

# --- Wo die drei ihre eigenen Werte finden ----------------------------------
#
# Unverändert die Dateien von vorher. Dort steht je Anwendung BASIS_URL,
# die Mailkonfiguration und alles Übrige. Ein DB_PATH darin ist seit dem
# Umzug nach PostgreSQL ohne Wirkung und kann weg.

KENNZEICHEN_ENV=/etc/abfahrt/kennzeichen.env
PRESSE_ENV=/etc/abfahrt/presse.env
HELFER_ENV=/etc/abfahrt/helfer.env
